# Public URLs for the ZIP archives containing the model files.
# Do not commit real signed URLs or access tokens.
TENNIS_MODEL_URL=
TENNIS_MODEL_SHA256=
ABSA_MODEL_URL=
ABSA_MODEL_SHA256=

# Frontend API origin. Leave empty when using Vite's local /api proxy.
# On Vercel, set this to e.g. https://tennis-ai-api.onrender.com
VITE_API_BASE_URL=

# Local-only Flask convenience. Keep this false in any deployed environment.
FLASK_DEBUG=false
